# Orquestração do docker-compose (raiz) — lido SÓ pelo compose.
# Só o compose interpola ${VAR} a partir deste arquivo; server/.env e web/.env
# NÃO são vistos aqui. Rodando nativo (python run.py / pnpm dev), este arquivo
# é ignorado — vale server/.env (backend) e web/.env (frontend).
#
# Config do app: backend -> server/.env | frontend (dev) -> web/.env

# Build arg do frontend: URL do backend embutida no bundle no build da imagem web
VITE_API_URL=http://localhost:3333

# Portas publicadas no host. API_PORT também é injetada no container do backend
# (é a porta em que o uvicorn escuta lá dentro).
API_PORT=3333
WEB_PORT=8080
