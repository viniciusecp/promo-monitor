# Telegram API credentials (obrigatório)
# Obtenha em: https://my.telegram.org/apps
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=seu_api_hash_aqui
TELEGRAM_PHONE=+5511999999999

# LLM validation (LangChain + OpenRouter)
# Sem OPENROUTER_API_KEY, a validação fica desativada (só o matcher decide).
OPENROUTER_API_KEY=
LLM_MODEL=openrouter/free

# API
# No Docker, o valor vem do compose (API_PORT no container).
API_PORT=4999

# DATABASE_URL=sqlite:///data/promobot.db

# Primeiro usuário
AUTH_SEED_EMAIL=voce@exemplo.com
AUTH_SEED_PASSWORD=troque-esta-senha-agora

# Validade da sessão em dias. Cookie persistente, se renova a cada uso.
AUTH_SESSION_DAYS=30

# ATENÇÃO: deixe `false` enquanto a stack rodar em HTTP puro — um cookie
# `Secure` não é enviado por HTTP e ninguém consegue entrar.
# Mude para `true` só quando houver HTTPS na frente.
AUTH_COOKIE_SECURE=false

# Vazio no deploy normal (mesma origem). Preencha só para rodar pnpm dev
# apontando direto para a porta do backend, em vez do proxy do Vite.
# CORS_ORIGINS=["http://localhost:3000"]
